# TickeTask Docker ayarları. Bu dosyayı .env olarak kopyalayın.
# Varsayılanlar güvenli yerel çalışma için hazırdır; yalnızca gerekli satırları açın.

## Ağ
# TICKETASK_BIND_ADDRESS=0.0.0.0
# TICKETASK_PORT=8787
# APP_PUBLIC_ORIGIN=https://destek.sirket.com
# TRUST_PROXY=1

## Veri ve model konumları
# TICKETASK_DATA_ROOT=./data
# TICKETASK_MODEL_PRIMARY_ROOT=./data/ollama
# TICKETASK_MODEL_PRIMARY_HOST_PATH=D:/modeller/ollama
# TICKETASK_MODEL_SECONDARY_ROOT=./data/ollama-alternative
# TICKETASK_MODEL_SECONDARY_HOST_PATH=D:/modeller/ollama-yedek
# TICKETASK_MODEL_PRIMARY_LABEL=Birinci konum
# TICKETASK_MODEL_SECONDARY_LABEL=İkinci konum

## Kayıt ve izin listeleri
# ALLOW_SELF_REGISTRATION=0
# ALLOWED_SENDERS=it@example.com,destek@example.com
# ALLOWED_DOMAINS=example.com

## Ticket sistemleri (arayüzden de girilebilir)
# JIRA_BASE_URL=https://sirket.atlassian.net
# JIRA_EMAIL=it@example.com
# JIRA_API_TOKEN=
# TRELLO_API_KEY=
# TRELLO_TOKEN=
# GITHUB_TOKEN=
# GITHUB_API_URL=
# ASANA_TOKEN=
# CLICKUP_TOKEN=

## Webhook
# INBOUND_WEBHOOK_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WEBHOOK_OWNER_ID=local-user
